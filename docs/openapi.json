  "info": {
    "title": "VexGo API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/captcha": {
      "get": {
        "operationId": "generate-captcha",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaptchaGenerateResponse"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Generate a sliding puzzle captcha",
        "tags": [
          "captcha"
        ]
      }
    },
    "/captcha/verify": {
      "post": {
        "operationId": "verify-captcha",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CaptchaVerifyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaptchaVerifyResponse"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Verify a captcha solution",
        "tags": [
          "captcha"
        ]
      }
    },
    "/notifications": {
      "get": {
        "operationId": "get-notifications",
        "parameters": [
          {
            "description": "1-based page index",
            "explode": false,
            "in": "query",
            "name": "page",
            "schema": {
              "default": 1,
              "description": "1-based page index",
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "description": "page size; capped at 100",
            "explode": false,
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 10,
              "description": "page size; capped at 100",
              "format": "int64",
              "type": "integer"
            }
          },
          {
            "description": "Filter by notification type",
            "explode": false,
            "in": "query",
            "name": "type",
            "schema": {
              "description": "Filter by notification type",
              "type": "string"
            }
          },
          {
            "description": "Filter by read state (\"true\"/\"false\")",
            "explode": false,
            "in": "query",
            "name": "is_read",
            "schema": {
              "description": "Filter by read state (\"true\"/\"false\")",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationsResponse"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "List notifications for the current user",
        "tags": [
          "notifications"
        ]
      }
    },
    "/notifications/read-all": {
      "put": {
        "operationId": "mark-all-notifications-read",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            },
            "description": "OK"
          },
